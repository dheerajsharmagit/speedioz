{
  "openapi": "3.1.0",
  "info": {
    "title": "RIDEHER frontend integration reference",
    "version": "0.1.0",
    "description": "Derived from frontend usage, not a backend-certified specification. Request/response schemas, ownership guarantees and missing lifecycle endpoints must be supplied by the backend. Supabase legacy table operations are not used for ride booking."
  },
  "servers": [
    {
      "url": "https://api.rideher.in/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Email and password login with expectedRole",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "security": []
      }
    },
    "/auth/signup/customer": {
      "post": {
        "summary": "Customer registration",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "security": []
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh authentication",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "security": []
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Read authenticated account",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/rides/request": {
      "post": {
        "summary": "Create ride using Idempotency-Key",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rides/history/me": {
      "get": {
        "summary": "Read customer ride history including active rides for recovery",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/rides/{id}/booking-details": {
      "get": {
        "summary": "Read participant booking details",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rides/{id}/cancel": {
      "post": {
        "summary": "Cancel ride and return canonical state",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rides/estimate": {
      "post": {
        "summary": "Estimate route and vehicle fares",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/rides/{id}/rate": {
      "post": {
        "summary": "Rate completed trip",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/payments/ride/{id}": {
      "get": {
        "summary": "Read payment status",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/captains/me/availability": {
      "patch": {
        "summary": "Update captain availability",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/rides/offers/me": {
      "get": {
        "summary": "Read captain offers",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/rides/{id}/accept": {
      "post": {
        "summary": "Accept offer",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rides/{id}/arrived": {
      "post": {
        "summary": "Mark arrival",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/community-routes": {
      "get": {
        "summary": "Read community route catalog",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Read user profile",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    },
    "/users/me/wallet": {
      "get": {
        "summary": "Read wallet balance",
        "responses": {
          "200": {
            "description": "Shape depends on backend contract; consult frontend client."
          }
        }
      }
    }
  }
}
